#!/usr/bin/env bash
# Verifies feature selection without compiling Warp by stubbing cargo check.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

cat > "$TEMP_DIR/cargo" <<'EOF'
#!/usr/bin/env bash
if [[ "$1" == "metadata" ]]; then
  printf '%s\n' '{"packages":[{"name":"wasm-bindgen","version":"0.2.0"}]}'
  exit 0
fi
printf '%s\n' "$@" > "$WASM_BUNDLE_TEST_ARGS"
printf '%s\n' "${WITH_LOCAL_SERVER:-}" > "$WASM_BUNDLE_TEST_WITH_LOCAL_SERVER"
EOF
chmod +x "$TEMP_DIR/cargo"
WASM_BUNDLE_TEST_ARGS="$TEMP_DIR/args"
WASM_BUNDLE_TEST_WITH_LOCAL_SERVER="$TEMP_DIR/with_local_server"

assert_args() {
  local expected_features="$1"
  grep -Fx -- "--features" "$WASM_BUNDLE_TEST_ARGS" >/dev/null
  grep -Fx -- "$expected_features" "$WASM_BUNDLE_TEST_ARGS" >/dev/null
}

run_bundle() {
  PATH="$TEMP_DIR:$PATH" \
    WASM_BUNDLE_TEST_ARGS="$TEMP_DIR/args" \
    WASM_BUNDLE_TEST_WITH_LOCAL_SERVER="$TEMP_DIR/with_local_server" \
    "$REPO_ROOT/script/wasm/bundle" --check-only "$@"
}

run_bundle --channel local --features "custom,with_local_server"
assert_args "release_bundle,gui,remote_tty,custom"
[[ "$(cat "$TEMP_DIR/with_local_server")" == "1" ]]

run_bundle --channel local --override-features "custom,with_local_server"
assert_args "custom"
[[ "$(cat "$TEMP_DIR/with_local_server")" == "1" ]]

run_bundle --features "gui,custom" --features "custom,another"
assert_args "release_bundle,gui,custom,another"

PATH="$TEMP_DIR:$PATH" \
  WASM_BUNDLE_TEST_ARGS="$WASM_BUNDLE_TEST_ARGS" \
  WASM_BUNDLE_TEST_WITH_LOCAL_SERVER="$WASM_BUNDLE_TEST_WITH_LOCAL_SERVER" \
  "$REPO_ROOT/script/wasm/run" --check-only --features "custom"
assert_args "release_bundle,gui,remote_tty,custom"
