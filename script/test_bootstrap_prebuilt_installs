#!/usr/bin/env bash
#
# Asserts that the cargo tools on the bootstrap critical path are installed from
# prebuilt binaries, that the one binary bootstrap downloads and runs directly
# (cargo-binstall) is verified first, and that binstall keeps its source-compile
# fallback. Re-adding a `cargo install` for any of them puts a multi-minute source
# build back into every fresh bootstrap.

set -eo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# This file names the same commands it searches for, so it is excluded from its own
# scan to keep the assertions from being self-satisfying.
SELF="$(basename "${BASH_SOURCE[0]}")"

scan() {
    grep -rn --exclude="$SELF" "$@" script || true
}

status=0

for tool in cargo-binstall cargo-bundle cargo-about; do
    source_installs="$(scan "cargo install" | grep -- "$tool" || true)"
    if [ -n "$source_installs" ]; then
        echo "error: $tool must be installed from a prebuilt binary, found source install(s):"
        echo "$source_installs"
        status=1
    fi
done

# cargo-binstall can't install itself, so its own install downloads a release archive
# and executes it. That is only acceptable with an integrity check, so require both
# the download and the digest it is checked against.
BINSTALL_INSTALLER="script/install_cargo_binstall"

if ! grep -q "releases/download" "$BINSTALL_INSTALLER"; then
    echo "error: $BINSTALL_INSTALLER must install cargo-binstall from its prebuilt release"
    status=1
fi

if ! grep -q "EXPECTED_SHA256" "$BINSTALL_INSTALLER"; then
    echo "error: $BINSTALL_INSTALLER must verify the release archive against a pinned SHA-256 before running it"
    status=1
fi

for tool in cargo-bundle cargo-about; do
    if [ -z "$(scan "cargo binstall" | grep -- "$tool" || true)" ]; then
        echo "error: no script installs $tool with cargo binstall"
        status=1
    fi
done

# binstall's source-compile fallback stays enabled on purpose: when a prebuilt can't
# be resolved, a slow bootstrap is a better outcome than one that can't finish.
disabled_compile="$(scan -e "--disable-strategies compile")"
if [ -n "$disabled_compile" ]; then
    echo "error: binstall's compile fallback must stay available, found:"
    echo "$disabled_compile"
    status=1
fi

if [ "$status" -eq 0 ]; then
    echo "Bootstrap prebuilt install check succeeded."
fi

exit "$status"
