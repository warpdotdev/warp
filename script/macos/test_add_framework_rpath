#!/bin/bash
#
# Exercises `script/macos/add_framework_rpath` against stubbed `otool` and
# `install_name_tool`, so the guard can be verified on any platform.

set -e

workspace_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT

stub_dir="$temp_dir/stubs"
binary_path="$temp_dir/dev"
other_binary_path="$temp_dir/dev-arm64"
otool_output_file="$temp_dir/otool-output"
install_name_tool_args_file="$temp_dir/install-name-tool-args"
expected_args_file="$temp_dir/expected-args"

mkdir -p "$stub_dir"
touch "$binary_path" "$other_binary_path"

cat > "$stub_dir/otool" << 'EOF'
#!/bin/bash
cat "$OTOOL_OUTPUT_FILE"
EOF
cat > "$stub_dir/install_name_tool" << 'EOF'
#!/bin/bash
printf '%s\n' "$@" >> "$INSTALL_NAME_TOOL_ARGS_FILE"
EOF
chmod +x "$stub_dir/otool" "$stub_dir/install_name_tool"

add_framework_rpath() {
  : > "$install_name_tool_args_file"
  OTOOL_OUTPUT_FILE="$otool_output_file" \
    INSTALL_NAME_TOOL_ARGS_FILE="$install_name_tool_args_file" \
    PATH="$stub_dir:$PATH" \
    "$workspace_root/script/macos/add_framework_rpath" "$@"
}

# A binary without the Frameworks rpath: the rpath is added. The dylib load
# command carries the same payload under a different field name, and the
# unrelated LC_RPATH is followed by another load command, so this also covers
# the parser mistaking either one for a Frameworks LC_RPATH.
cat > "$otool_output_file" << 'EOF'
Load command 12
          cmd LC_LOAD_DYLIB
      cmdsize 56
         name @executable_path/../Frameworks (offset 24)
Load command 15
          cmd LC_RPATH
      cmdsize 40
         path @loader_path/../Frameworks (offset 12)
Load command 16
          cmd LC_BUILD_VERSION
      cmdsize 32
         path this is not an rpath (offset 12)
EOF
add_framework_rpath "$binary_path"
cat > "$expected_args_file" << EOF
-add_rpath
@executable_path/../Frameworks
$binary_path
EOF
cmp "$expected_args_file" "$install_name_tool_args_file"

# A binary that cargo-bundle already gave the rpath to: the add is skipped.
cat > "$otool_output_file" << 'EOF'
Load command 15
          cmd LC_RPATH
      cmdsize 48
         path @executable_path/../Frameworks (offset 12)
EOF
add_framework_rpath "$binary_path"
: > "$expected_args_file"
cmp "$expected_args_file" "$install_name_tool_args_file"

# Every binary passed in is inspected, and the skip applies per binary.
add_framework_rpath "$binary_path" "$other_binary_path"
cmp "$expected_args_file" "$install_name_tool_args_file"

# A missing binary is an error rather than a silent no-op.
if add_framework_rpath "$temp_dir/does-not-exist" 2> /dev/null; then
  echo "Expected a missing binary to fail" >&2
  exit 1
fi
