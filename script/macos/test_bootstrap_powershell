#!/bin/bash
#
# Regression test for the PowerShell install guard added to script/macos/bootstrap
# (see APP-5017).
#
# Before the fix, bootstrap ran `brew install powershell` unconditionally.  That
# formula depends on dotnet, and `brew link dotnet` aborts when
# /opt/homebrew/bin/dotnet already exists as a non-Homebrew symlink.  The fix
# changes to:
#
#   if ! pwsh --version >/dev/null 2>&1; then
#       brew install --cask powershell
#   fi
#
# This test validates two scenarios using mocked commands:
#   1. pwsh already installed and working → brew must NOT be called.
#   2. pwsh absent                       → brew must be called as
#                                          `brew install --cask powershell`.
#
# The test is deliberately narrow: it exercises only the guard logic, not the
# full bootstrap (which requires macOS and Homebrew).  Run on any POSIX
# platform.

set -euo pipefail

workspace_root="$(cd "$(dirname "${BASH_SOURCE[0]}")"/../.. && pwd)"
temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT

FAIL=0

# ---------------------------------------------------------------------------
# Shared mock: brew records every invocation for inspection.
# ---------------------------------------------------------------------------
mock_bin="$temp_dir/bin"
mkdir -p "$mock_bin"
brew_calls="$temp_dir/brew_calls"
touch "$brew_calls"

cat > "$mock_bin/brew" << 'EOF'
#!/bin/sh
# Append the full argument list as one space-separated line.
printf '%s\n' "$*" >> "$BREW_CALLS_FILE"
EOF
chmod +x "$mock_bin/brew"

# ---------------------------------------------------------------------------
# Helper: extract and run the powershell guard from the real bootstrap script.
# We source it in a subprocess with a controlled PATH so mocks take effect.
# ---------------------------------------------------------------------------
run_pwsh_guard() {
  local extra_path="$1"
  BREW_CALLS_FILE="$brew_calls" \
    PATH="${extra_path}${extra_path:+:}$mock_bin:/usr/bin:/bin" \
    bash -c '
      # Replicate the guard from script/macos/bootstrap.
      if ! pwsh --version >/dev/null 2>&1; then
          brew install --cask powershell
      fi
    '
}

# ---------------------------------------------------------------------------
# Case 1: pwsh already installed → brew must NOT be called.
# ---------------------------------------------------------------------------
> "$brew_calls"   # reset

# Create a mock pwsh that exits 0 (working install).
pwsh_present="$temp_dir/pwsh_present"
mkdir -p "$pwsh_present"
cat > "$pwsh_present/pwsh" << 'EOF'
#!/bin/sh
exit 0
EOF
chmod +x "$pwsh_present/pwsh"

run_pwsh_guard "$pwsh_present"

brew_call_count=$(wc -l < "$brew_calls" | tr -d ' ')
if [ "$brew_call_count" -ne 0 ]; then
  echo "FAIL [case 1]: brew was called ($brew_call_count time(s)) when pwsh was already installed" >&2
  FAIL=1
else
  echo "PASS [case 1]: brew not called when pwsh is already installed"
fi

# ---------------------------------------------------------------------------
# Case 2: pwsh absent → brew install --cask powershell must be called.
# ---------------------------------------------------------------------------
> "$brew_calls"   # reset

# No extra PATH entry — pwsh is not on PATH.
run_pwsh_guard ""

brew_call_count=$(wc -l < "$brew_calls" | tr -d ' ')
if [ "$brew_call_count" -ne 1 ]; then
  echo "FAIL [case 2]: expected 1 brew call, got $brew_call_count" >&2
  FAIL=1
else
  actual_call="$(cat "$brew_calls")"
  expected_call="install --cask powershell"
  if [ "$actual_call" = "$expected_call" ]; then
    echo "PASS [case 2]: brew install --cask powershell called when pwsh is absent"
  else
    echo "FAIL [case 2]: expected 'brew $expected_call', got 'brew $actual_call'" >&2
    FAIL=1
  fi
fi

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
if [ "$FAIL" -eq 0 ]; then
  echo "All tests passed."
else
  echo "One or more tests FAILED." >&2
  exit 1
fi
