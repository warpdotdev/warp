#!/bin/bash
#
# Installs cargo-bundle, which packages the macOS .app bundle.

# This script should be platform-agnostic (eg. no unix-only references like /dev/null).

set -eo pipefail

# Both local bootstrap and release CI install through this script so that the .app
# bundles developers produce come from the same cargo-bundle as the shipped ones.
#
# 0.11.0 supports the two features script/macos/bundle depends on: the `--profile`
# flag and CARGO_BUNDLE_SKIP_BUILD.
CARGO_BUNDLE_VERSION="0.11.0"

"$PWD"/script/install_cargo_binstall

# burtonageo/cargo-bundle publishes no release assets, so binstall resolves this
# through cargo-quickinstall, which covers both apple-darwin targets. On a target
# quickinstall doesn't cover, binstall falls back to building from source.
cargo binstall --no-confirm "cargo-bundle@${CARGO_BUNDLE_VERSION}"
